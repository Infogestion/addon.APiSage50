<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia este fichero como S50APIService.secretos.config (en la misma carpeta que el .csproj; al compilar se copia junto al .exe)
  y rellena los valores. Ese fichero está en .gitignore: no lo subas al repositorio.
-->
<appSettings>
  <!-- Clave con la que se firman los tokens JWT. Si es la misma que usa interface.s50c (Consts.AUTH.SECRETKEY),
       los tokens de una API valen en la otra, lo que facilita la migración de las aplicaciones.
       Vacía = se genera una aleatoria en cada arranque y los tokens dejan de valer al reiniciar. -->
  <add key="JwtClave" value="" />

  <!-- Usuarios de POST /api/token/{username}/{password}: los mismos que interface.s50c (AuthenticationService).
       Una línea por usuario: key="ApiUsuario:NOMBRE" value="CONTRASEÑA". Distinguen mayúsculas y minúsculas. -->
  <add key="ApiUsuario:usuario" value="contraseña" />
</appSettings>
