<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Dirección de la API. Con "localhost" no hacen falta permisos de administrador;
         para escuchar en todas las interfaces (http://+:9000/) hay que reservar la URL con netsh http add urlacl. -->
    <add key="Url" value="http://localhost:9000/" />

    <!-- Carpeta del terminal de Sage (la que contiene config.ini). -->
    <add key="SageTerminal" value="D:\Sage50Tias\Sage50Term2" />
    <!-- Carpeta de librerías de Sage. Vacía = la subcarpeta de versión más alta del terminal, como hace sage.50.exe. -->
    <add key="SageLibrerias" value="" />
    <!-- Grupo de empresas (base de datos de comunes) y empresa. -->
    <add key="SageGrupo" value="COMU0001" />
    <add key="SageEmpresa" value="01" />

    <!-- Segundos que se espera una operación de Sage antes de darla por bloqueada (p. ej. por un diálogo modal). -->
    <add key="SageTimeoutSegundos" value="180" />
  </appSettings>
</configuration>
